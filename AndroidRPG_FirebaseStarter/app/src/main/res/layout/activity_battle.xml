<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1B"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Naslov -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fight the Boss!"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingBottom="12dp"
            android:gravity="center"/>

        <!-- Boss HP bar -->
        <TextView
            android:id="@+id/tvBossHp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boss HP: 200 / 200"
            android:textColor="#FF5555"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/bossHpBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="250dp"
            android:layout_height="20dp"
            android:max="200"
            android:progress="200"
            android:progressTint="#FF3333"
            android:indeterminate="false"
            android:layout_marginBottom="16dp"
            android:background="#330000"/>

        <!-- Slika bosa -->
        <ImageView
            android:id="@+id/imgBoss"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/boss_idle"
            android:contentDescription="Boss"
            android:layout_marginBottom="10dp" />

        <!-- Oprema koja je aktivna -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Equipment:"
            android:textColor="#AAAAAA"
            android:textStyle="bold"
            android:paddingTop="4dp"/>

        <ImageView
            android:id="@+id/imgEquipment"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/cloak_icon"
            android:layout_marginBottom="20dp"
            android:visibility="gone"/>

        <!-- PP korisnika -->
        <TextView
            android:id="@+id/tvUserPp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your PP: 100"
            android:textColor="#77BBFF"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/userPpBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="250dp"
            android:layout_height="20dp"
            android:max="500"
            android:progress="100"
            android:progressTint="#33AAFF"
            android:indeterminate="false"
            android:background="#002244"
            android:layout_marginBottom="20dp"/>

        <!-- Dugme za napad -->
        <Button
            android:id="@+id/btnAttack"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="Attack!"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E53935"
            android:layout_marginBottom="14dp"/>

        <!-- Broj preostalih napada -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tries left: 5 / 5"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Kovčeg za nagrade -->
        <ImageView
            android:id="@+id/imgChest"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/chest_closed"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:contentDescription="Reward Chest"/>

        <!-- Tekst sa ishodom borbe -->
        <TextView
            android:id="@+id/tvBattleSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DDDDDD"
            android:textStyle="italic"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingTop="8dp"/>
    </LinearLayout>
</ScrollView>
