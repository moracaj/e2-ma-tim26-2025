<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create new task:"
            android:textSize="20sp"
            android:paddingBottom="12dp" />
        <!-- 1. Kategorija -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category:"
            android:textSize="18sp"/>
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 2. Učestalost -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Frequency:"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>

        <RadioGroup
            android:id="@+id/rgFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbOneTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One time" />

            <RadioButton
                android:id="@+id/rbRecurring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recurring" />
        </RadioGroup>



        <LinearLayout
            android:id="@+id/layoutRecurring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <!-- Interval + jedinica ponavljanja -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etRepeatInterval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Interval (npr. 2)"
                    android:inputType="number" />

                <Spinner
                    android:id="@+id/spinnerRepeatUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:entries="@array/repeat_units" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDateRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select date range" />
        </LinearLayout>


        <!-- 3. Težina -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Difficulty:"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>
        <Spinner
            android:id="@+id/spinnerDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 4. Bitnost -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Importance:"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>
        <Spinner
            android:id="@+id/spinnerImportance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 5. Naziv zadatka -->
        <EditText
            android:id="@+id/taskName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Task name" />

        <!-- 6. Opis zadatka -->
        <EditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description (optional)"
            android:inputType="textMultiLine"
            android:lines="3"
            android:gravity="top" />

        <!-- 7. Vreme izvršenja -->
        <Button
            android:id="@+id/btnExecutionTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Execution time" />

        <!-- Dugme za čuvanje -->
        <Button
            android:id="@+id/btnSaveTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sačuvaj zadatak" />


    </LinearLayout>
</ScrollView>
